# Headers for every file the site Worker serves (Workers Static Assets reads this file; it is not served itself).
# GitHub Pages could not send any of these, which is why the frame check also lives in main.tsx.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite's bundles carry a hash of their contents in the name, so they never change
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The pets' pictures (the small heads in chat and on profiles, the portraits in the gallery and on share cards, Emotown's
# banners): the same file for months, and until 2026-10-02 every one was asked for again on every view (max-age=0), which
# is why a face was an empty circle for a moment each time. A day, and after that the old one is shown while it is checked.
/social/av/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/social/banners/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/nft/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

# the service worker must never be cached (a deploy is live the moment it lands), and the manifest wants its own type
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
